+def _copy_remainder_prefix(src: State, dst: State) -> None:
+    """Alloy (SCR-WP11-F32): the sub-ulp position remainder (State.particle_q_lo, patch 0007) rides with particle_q.
+    A substepped entry steps from ``state_1`` after ``_copy_same_view_state(state_0, state_1)``; without this its first
+    substep read the remainder ``state_1`` kept from the last exchange (a rolled-back attempt's, after a restore) and
+    an odd substep count left the final one in ``state_tmp``. From a State without it, the destination's is zeroed."""
+    lo_src, lo_dst = getattr(src, "particle_q_lo", None), getattr(dst, "particle_q_lo", None)
+    if lo_dst is None:
+        return
+    if lo_src is None:
+        lo_dst.zero_()
+    else:
+        _copy_prefix(lo_dst, lo_src, "particle_q_lo")
+

+@wp.kernel(enable_backward=False)
+def _copy_mapped_particle_vec3(local_to_global: wp.array[int], src: wp.array[wp.vec3], dst: wp.array[wp.vec3]):
+    local_id = wp.tid()
+    global_id = local_to_global[local_id]
+    if global_id < 0:
+        return
+    dst[local_id] = src[global_id]
+
+
+@wp.kernel(enable_backward=False)
+def _scatter_mapped_particle_vec3(
+    indices: wp.array[int], global_to_local: wp.array[int], src: wp.array[wp.vec3], dst: wp.array[wp.vec3]
+):
+    global_id = indices[wp.tid()]
+    local_id = global_to_local[global_id]
+    if local_id < 0:
+        return
+    dst[global_id] = src[local_id]
+
+
+def _copy_particle_remainder(src: State, dst: State, local_to_global: wp.array, device) -> None:
+    """Alloy (SCR-WP11-F32): the particles' sub-ulp position remainder (State.particle_q_lo) rides with particle_q
+    into an entry; from a State without it (hand-built), the entry's is zeroed beside the new particle_q."""
+    lo_src, lo_dst = getattr(src, "particle_q_lo", None), getattr(dst, "particle_q_lo", None)
+    if lo_dst is not None and lo_src is None:
+        lo_dst.zero_()
+    elif lo_src is not None and lo_dst is not None and local_to_global.shape[0] > 0:
+        wp.launch(_copy_mapped_particle_vec3, dim=local_to_global.shape[0], inputs=[local_to_global, lo_src],
+                  outputs=[lo_dst], device=device)
+
+
+def _scatter_particle_remainder(entry: SolverEntry, state_out: State, device) -> None:
+    """Alloy (SCR-WP11-F32): an entry's particle_q_lo back into the scene state, with particle_q."""
+    lo_src, lo_dst = getattr(entry.state_1, "particle_q_lo", None), getattr(state_out, "particle_q_lo", None)
+    if lo_src is not None and lo_dst is not None:
+        wp.launch(_scatter_mapped_particle_vec3, dim=entry.particle_indices.shape[0],
+                  inputs=[entry.particle_indices, entry.particle_global_to_local, lo_src], outputs=[lo_dst],
+                  device=device)
+

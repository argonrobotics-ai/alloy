+@wp.kernel
+def mark_active_blocks(
+    color_blocks: wp.array2d[int],
+    strain_residual: wp.array[float],
+    threshold2: float,
+    world_offsets: wp.array[int],
+    block_active: wp.array[wp.int32],
+):
+    """Alloy (S5, partial sweeps): a colour block stays active while any of its rows moved more than the threshold in
+    the last full sweep (``strain_residual`` holds each row's squared update, ``evaluate_strain_residual``), and
+    always when its rows span worlds (``world_offsets``, WP8's review: else one world's sweep would follow another's
+    rows; nothing pins Newton's blocking to worlds)."""
+    b = wp.tid()
+    beg, end = color_blocks[0, b], color_blocks[1, b]
+    active = wp.int32(0)
+    if world_offsets.shape[0] > 1 and end > beg:
+        if _world_of(world_offsets, beg) != _world_of(world_offsets, end - 1):
+            active = wp.int32(1)
+    for i in range(beg, end):
+        if strain_residual[i] > threshold2:
+            active = wp.int32(1)
+    block_active[b] = active
+

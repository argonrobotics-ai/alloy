+@wp.func
+def _world_of(offsets: wp.array[int], i: int):  # Alloy (GAPS-NOW #5a, mpm-skip-converged)
+    """The world whose strain-node range holds ``i`` (offsets ascending, ``offsets[-1]`` the end)."""
+    lo = int(0)
+    hi = offsets.shape[0] - 1
+    while hi - lo > 1:
+        mid = (lo + hi) // 2
+        if offsets[mid] <= i:
+            lo = mid
+        else:
+            hi = mid
+    return lo

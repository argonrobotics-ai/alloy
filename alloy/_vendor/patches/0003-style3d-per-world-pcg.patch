+# Alloy (SCR-WP0-S3D-WORLDS): per-world inner products, deterministic (fixed chunks that never cross a world
+# boundary, then each world's chunks in order). Upstream summed over every world's particles, so every world shared one
+# alpha and one beta and a world's solve depended on the other worlds' state.
+@wp.kernel
+def chunk_inner_kernel(
+    a: wp.array[wp.vec3],
+    b: wp.array[wp.vec3],
+    chunk_start: wp.array[wp.int32],
+    chunk_end: wp.array[wp.int32],
+    # outputs
+    partial: wp.array[float],
+):
+    c = wp.tid()
+    s = float(0.0)
+    for i in range(chunk_start[c], chunk_end[c]):
+        s += wp.dot(a[i], b[i])
+    partial[c] = s
+
+
+@wp.kernel
+def world_inner_kernel(
+    partial: wp.array[float],
+    world_chunk_start: wp.array[wp.int32],
+    iter: int,
+    worlds: int,
+    # outputs
+    out: wp.array[float],
+):
+    w = wp.tid()
+    s = float(0.0)
+    for c in range(world_chunk_start[w], world_chunk_start[w + 1]):
+        s += partial[c]
+    out[iter * worlds + w] = s
+
+
+def world_tables(particle_world: wp.array | None, chunk: int = 256):
+    """Alloy (SCR-WP0-S3D-WORLDS): (worlds, dense world per particle, chunk starts, chunk ends, first chunk per
+    world) when there is more than one world and each world's particles are contiguous; None otherwise (upstream's
+    global sums, as for one world)."""
+    if particle_world is None:
+        return None
+    pw = particle_world.numpy()
+    if pw.size == 0 or pw.min() < 0 or (np.diff(pw) < 0).any():
+        return None
+    ids, dense = np.unique(pw, return_inverse=True)
+    if len(ids) < 2:
+        return None
+    bounds = np.flatnonzero(np.diff(dense)) + 1
+    starts, ends = np.r_[0, bounds], np.r_[bounds, len(pw)]
+    cs, ce, first = [], [], [0]
+    for s, e in zip(starts, ends, strict=True):
+        for c in range(int(s), int(e), chunk):
+            cs.append(c)
+            ce.append(min(c + chunk, int(e)))
+        first.append(len(cs))
+    return len(ids), dense.astype(np.int32), np.array(cs, np.int32), np.array(ce, np.int32), np.array(first, np.int32)
+

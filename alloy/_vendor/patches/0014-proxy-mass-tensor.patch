+# Alloy (proxy-mass-tensor): the two definitions below are new; ``forward_step_rigid_bodies`` above is unchanged.
+@wp.func
+def integrate_rigid_body_tensor(
+    q: wp.transform,
+    qd: wp.spatial_vector,
+    f: wp.spatial_vector,
+    com: wp.vec3,
+    inertia: wp.mat33,
+    inv_mass: float,
+    inv_mass_tensor: wp.mat33,
+    inv_inertia: wp.mat33,
+    gravity: wp.vec3,
+    angular_damping: float,
+    dt: float,
+):
+    """``integrate_rigid_body`` (solvers/solver.py) with a 3x3 inverse mass for the force term.
+
+    ``inv_mass_tensor`` is in the body frame; the world tensor is ``R * inv_mass_tensor * R^T`` with R the
+    orientation at the start of the step (``q``). Gravity enters as the force ``gravity / inv_mass`` through the
+    same tensor: a body with ``identity * inv_mass`` falls with g as before, and a coupling proxy, whose force
+    input already carries ``-gravity / inv_mass`` from the coupler (``subtract_proxy_body_forces_kernel``), has no
+    net gravity along any direction, as with the scalar mass. Every other line is ``integrate_rigid_body``'s.
+    """
+    # unpack transform
+    x0 = wp.transform_get_translation(q)
+    r0 = wp.transform_get_rotation(q)
+
+    # unpack spatial twist
+    w0 = wp.spatial_bottom(qd)
+    v0 = wp.spatial_top(qd)
+
+    # unpack spatial wrench
+    t0 = wp.spatial_bottom(f)
+    f0 = wp.spatial_top(f)
+
+    x_com = x0 + wp.quat_rotate(r0, com)
+
+    # linear part: world inverse mass tensor from the start-of-step orientation
+    rot0 = wp.quat_to_matrix(r0)
+    inv_mass_world = rot0 * inv_mass_tensor * wp.transpose(rot0)
+    weight = wp.vec3(0.0, 0.0, 0.0)
+    if inv_mass > 0.0:
+        weight = gravity / inv_mass
+    v1 = v0 + inv_mass_world * (f0 + weight) * dt
+    x1 = x_com + v1 * dt
+
+    # angular part (compute in body frame)
+    wb = wp.quat_rotate_inv(r0, w0)
+    tb = wp.quat_rotate_inv(r0, t0) - wp.cross(wb, inertia * wb)  # coriolis forces
+
+    w1 = wp.quat_rotate(r0, wb + inv_inertia * tb * dt)
+    r1 = wp.normalize(r0 + wp.quat(w1, 0.0) * r0 * 0.5 * dt)
+
+    # angular damping
+    w1 *= 1.0 - angular_damping * dt
+
+    q_new = wp.transform(x1 - wp.quat_rotate(r1, com), r1)
+    qd_new = wp.spatial_vector(v1, w1)
+
+    return q_new, qd_new
+
+
+@wp.kernel
+def forward_step_rigid_bodies_tensor(
+    # Inputs
+    dt: float,
+    gravity: wp.array[wp.vec3],
+    body_world: wp.array[wp.int32],
+    pose_rebaseline_mask: wp.array[wp.bool],
+    body_f: wp.array[wp.spatial_vector],
+    body_com: wp.array[wp.vec3],
+    body_inertia: wp.array[wp.mat33],
+    body_inv_mass: wp.array[float],
+    body_inv_inertia: wp.array[wp.mat33],
+    body_q: wp.array[wp.transform],
+    body_qd: wp.array[wp.spatial_vector],
+    body_inv_mass_tensor: wp.array[wp.mat33],
+    body_q_prev: wp.array[wp.transform],
+    body_inertia_q: wp.array[wp.transform],
+):
+    """``forward_step_rigid_bodies`` with a per-body 3x3 inverse mass (body frame) for the force term.
+
+    A copy of ``forward_step_rigid_bodies`` that takes ``body_inv_mass_tensor`` and calls
+    :func:`integrate_rigid_body_tensor`. The scalar ``body_inv_mass`` still gates kinematic bodies and gravity.
+    """
+    tid = wp.tid()
+
+    world_idx = body_world[tid]
+    q_current = body_q[tid]
+    if _world_selected(world_idx, pose_rebaseline_mask):
+        # The constructor or reset() may precede state pose preparation.
+        body_q_prev[tid] = q_current
+
+    # Early exit for kinematic bodies (inv_mass == 0).
+    inv_m = body_inv_mass[tid]
+    if inv_m == 0.0:
+        body_inertia_q[tid] = q_current
+        return
+
+    # Read body state (only for dynamic bodies)
+    qd_current = body_qd[tid]
+    f_current = body_f[tid]
+    com_local = body_com[tid]
+    I_local = body_inertia[tid]
+    inv_I = body_inv_inertia[tid]
+    world_g = gravity[world_idx]
+
+    q_new, qd_new = integrate_rigid_body_tensor(
+        q_current,
+        qd_current,
+        f_current,
+        com_local,
+        I_local,
+        inv_m,
+        body_inv_mass_tensor[tid],
+        inv_I,
+        world_g,
+        0.0,  # angular_damping = 0 (consistent with particle VBD)
+        dt,
+    )
+
+    # Update current transform, velocity, and set inertial target
+    body_q[tid] = q_new
+    body_qd[tid] = qd_new
+    body_inertia_q[tid] = q_new
+
